# OpenAI / LLM provider for general chat
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Training coach bridge
TRAINING_COACH_URL=http://127.0.0.1:8000/chat

# Home Assistant integration (placeholder for later)
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=your_long_lived_token_here

# Personal Agent router
PERSONAL_AGENT_PORT=8101
